{
  "name": "index-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "dev:platform": "npm --workspace @1d3x/platform-web run dev",
    "dev:uga": "npm --workspace @1d3x/index-web run dev:uga",
    "dev:spike": "npm --workspace @1d3x/index-web run dev:spike",
    "build": "next build",
    "build:platform": "npm --workspace @1d3x/platform-web run build",
    "build:uga": "npm --workspace @1d3x/index-web run build:uga",
    "build:spike": "npm --workspace @1d3x/index-web run build:spike",
    "build:tenants": "npm run build:platform && npm run build:uga && npm run build:spike",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:platform": "PLAYWRIGHT_TENANT=1d3x PLAYWRIGHT_PORT=3101 playwright test",
    "test:e2e:uga": "PLAYWRIGHT_TENANT=uga-ua PLAYWRIGHT_PORT=3102 playwright test",
    "test:e2e:spike": "PLAYWRIGHT_TENANT=spike-ua PLAYWRIGHT_PORT=3103 playwright test",
    "test:e2e:tenants": "npm run test:e2e:platform && npm run test:e2e:uga && npm run test:e2e:spike",
    "check:production-env": "node scripts/check-production-env.mjs",
    "db:generate": "prisma generate",
    "db:seed": "prisma db seed",
    "deploy:1d3x": "node scripts/verify-vercel-project.mjs --project 1d3x && vercel --prod --yes --scope abvcreative --project 1d3x",
    "deploy:uga": "node scripts/verify-vercel-project.mjs --project uga-index && vercel --prod --yes --scope abvcreative --project uga-index",
    "deploy:spike": "node scripts/verify-vercel-project.mjs --project spike-ua-index && vercel --prod --yes --scope abvcreative --project spike-ua-index",
    "deploy:guard": "node scripts/verify-vercel-project.mjs",
    "sync:uga-from-spike": "tsx scripts/sync-uga-from-spike.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "next": "^15.3.0",
    "pg": "^8.20.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "overrides": {
    "@hono/node-server": "^1.19.13",
    "postcss": "^8.5.10"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/forms": "^0.5.10",
    "@types/node": "^22.15.3",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.25.1",
    "eslint-config-next": "^15.3.0",
    "postcss": "^8.5.10",
    "prisma": "^7.8.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.5"
  }
}
