    "cortex:editorial-shadow": "tsx scripts/cortex-editorial-shadow.ts",
    "cortex:editorial-corpus-backfill": "tsx scripts/cortex-editorial-corpus-backfill.ts",
    "cortex:editorial-match-diagnostics": "tsx scripts/cortex-editorial-match-diagnostics.ts",
    "cortex:editorial-promotion": "tsx scripts/cortex-editorial-promotion.ts",
