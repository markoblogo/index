    "cortex:autonomy-readiness": "tsx scripts/cortex-autonomy-readiness.ts",
    "cortex:operational-eval": "tsx scripts/cortex-operational-eval.ts",
    "cortex:sgr-lite-shadow-eval": "tsx scripts/cortex-sgr-lite-shadow-eval.ts",
    "cortex:artifact-smoke": "tsx scripts/cortex-artifact-smoke.ts",
    "cortex:cropto-source-chunk": "tsx scripts/cortex-cropto-source-chunk.ts",
    "cortex:memory-search": "tsx scripts/cortex-memory-search.ts",
    "cortex:mn7r-snapshot-chunk": "tsx scripts/cortex-mn7r-snapshot-chunk.ts",
    "cortex:source-chunk": "tsx scripts/cortex-source-chunk.ts",
    "cortex:source-ingest": "tsx scripts/cortex-source-ingest.ts",
    "cortex:source-scan": "tsx scripts/cortex-source-scan.ts",
